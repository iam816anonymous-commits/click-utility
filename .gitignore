# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, uncomment those lines:
# .python-version

# pipenv
#   According to pypa/pipenv#1255, pipenv should generally not be used
#   with projects, so ignore Pipfile.lock:
#Pipfile.lock

# poetry
#   Similarly, poetry.lock is use-case-specific and you may want to ignore it:
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is use-case-specific
#pdm.lock

# Scrapy stuff:
.scrapy

# PyCharm
